{
    "name": "loadapi-frontend",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:mock": "vite --mode mock",
        "build": "tsc -b && vite build",
        "build:mock": "tsc -b && vite build --mode mock",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run --project unit",
        "test:w": "vitest --project unit",
        "test:c": "vitest run --project unit --coverage",
        "test:storybook": "vitest run --project storybook",
        "test:e2e": "playwright test",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "api:generate": "orval",
        "routes:generate": "tsr generate",
        "postinstall": "tsr generate",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@hookform/resolvers": "^6.0.2",
        "@lezer/common": "^1.5.5",
        "@lezer/highlight": "^1.2.5",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.5.11",
        "lucide-react": "^1.63.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-i18next": "^17.1.9",
        "tailwind-merge": "^3.7.0",
        "uplot": "^1.6.32",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@babel/core": "^8.0.9",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/addon-vitest": "^10.6.5",
        "@storybook/react-vite": "^10.6.5",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.105.0",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-cli": "^1.167.46",
        "@tanstack/router-plugin": "^1.168.48",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "msw": "^3.0.3",
        "orval": "^8.45.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "storybook": "^10.6.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.21.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
